# 32자 이상 임의 문자열. 예: openssl rand -hex 32
SESSION_SECRET=
# 첫 실행 때 만들어지는 운영자 계정. ADMIN_PASSWORD를 비워 두면 첫 접속 때 /setup 화면에서 직접 만든다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# HTTPS 뒤에서만 true
COOKIE_SECURE=false
# 로컬 개발 시 DB 위치 (기본 ./data)
# DATA_DIR=./data
# 샷 프롬프트 AI 생성용 Anthropic API 키 (없으면 생성 버튼이 오류를 안내)
ANTHROPIC_API_KEY=
